# ==============================================================
# Observability & Resilient Pipeline - Environment Configuration
# ==============================================================

# Grafana Admin Credentials
GF_ADMIN_USER=admin
GF_ADMIN_PASSWORD=admin_resilient_2026

# Producer Rate Limiting (0 = disabled, or e.g. 500 for 500 RPS max)
PRODUCER_RATE_LIMIT_RPS=0

# Producer Reliability & Backpressure
PRODUCER_WAIT_FOR_ACK=true
PRODUCER_ACK_TIMEOUT_SECONDS=2.0
PRODUCER_MAX_CONCURRENT_PRODUCES=500

# Consumer Simulation Parameters
PROCESSING_MIN_MS=50
PROCESSING_MAX_MS=200
PROCESSING_ERROR_RATE=0

# Kafka Configuration
KAFKA_TOPIC=raw-events
KAFKA_DLQ_TOPIC=raw-events-dlq
KAFKA_CONSUMER_GROUP=events-processor

